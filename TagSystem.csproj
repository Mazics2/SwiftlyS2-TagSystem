<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>TagSystem</AssemblyName>
    <RootNamespace>TagSystem</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SwiftlyS2.CS2" Version="1.5.0" ExcludeAssets="runtime" />
    <PackageReference Include="Tomlyn" Version="0.17.0" />
    <Reference Include="PanoramaHud.Contract">
      <HintPath>libs\PanoramaHud.Contract.dll</HintPath>
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </Reference>
  </ItemGroup>

  <!--
    Yerel CS2 sunucusu mevcutsa build sonrasi dogrudan sunucu eklenti klasorune kopyalar.
  -->
  <PropertyGroup>
    <LocalServerPluginDir>C:\Users\CanDaysa\Desktop\Works\CS2\Sunucu\game\csgo\addons\swiftlys2\plugins\TagSystem</LocalServerPluginDir>
  </PropertyGroup>
  <Target Name="DeployToLocalServer" AfterTargets="Build" Condition="Exists('$(LocalServerPluginDir)')">
    <ItemGroup>
      <DeployFiles Include="$(OutputPath)$(AssemblyName).dll;$(OutputPath)$(AssemblyName).pdb;$(OutputPath)$(AssemblyName).deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(LocalServerPluginDir)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="TagSystem -&gt; $(LocalServerPluginDir) (yerel test sunucusu) kopyalandi." />
  </Target>

</Project>
